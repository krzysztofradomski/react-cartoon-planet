{
  "name": "react-cartoon-planet",
  "version": "1.0.0",
  "description": "Animated cartoon globe for React — zoom from orbit to ground level",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.geojson"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:geo": "node --experimental-strip-types scripts/test-geo.ts",
    "test:markers": "node --experimental-strip-types scripts/test-markers.ts",
    "test": "npm run test:geo && npm run test:markers",
    "test:int": "npm run test",
    "prepare": "npm run build"
  },
  "author": "hello@radomski.dev",
  "homepage": "https://react-cartoon-planet.paperplane.builders/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krzysztofradomski/react-cartoon-planet.git"
  },
  "bugs": {
    "url": "https://github.com/krzysztofradomski/react-cartoon-planet/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "globe",
    "cartoon",
    "planet",
    "animation",
    "three.js"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "three": ">=0.160"
  },
  "dependencies": {
    "earcut": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.160.0",
    "three": "^0.160.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
